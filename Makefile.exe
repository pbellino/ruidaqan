# ── Ejecutables (PyInstaller) ──────────────────────────────────────────────────
#
# Genera carpetas en dist/ con los ejecutables para el SO actual.
# Para Windows: correr en Windows con el venv activo.
# Para Linux:   correr en Linux con el venv activo.
#
# Requiere: pip install pyinstaller

SPECS_DIR = pyinstaller/specs

.PHONY: exe exe_adquisicion exe_procesamiento exe_resultados

exe: exe_adquisicion exe_procesamiento exe_resultados
	@echo ""
	@echo "Ejecutables generados en dist/:"
	@ls dist/ruidaqan-*/

exe_adquisicion:
	pyinstaller $(SPECS_DIR)/ruidaqan_adquisicion.spec --noconfirm

exe_procesamiento:
	pyinstaller $(SPECS_DIR)/ruidaqan_procesamiento.spec --noconfirm

exe_resultados:
	pyinstaller $(SPECS_DIR)/ruidaqan_resultados.spec --noconfirm
